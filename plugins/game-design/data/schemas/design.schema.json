{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mozg-godot:design:design",
  "title": "design",
  "description": "The frame of a game's design data, at design/design.json: stages in play order, playstyles, the node kinds that end a run and the targets analyze checks.",
  "type": "object",
  "required": [
    "schema",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "design/1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "description": "Balance model the design data feeds; campaign (default) needs stages, playstyles and terminal_kinds.",
      "enum": [
        "campaign",
        "combat",
        "rts"
      ]
    },
    "stages": {
      "description": "Acts or phases in play order; each node names one by id.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/named"
      }
    },
    "playstyles": {
      "description": "Ways to play that nodes are tagged with, such as a stealth or a builder route.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/named"
      }
    },
    "terminal_kinds": {
      "description": "Node kinds that end a run, such as Ending or Failure; they need no dependents.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pools": {
      "description": "Resources the economy tracks; node costs and yields name them by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/pool"
      }
    },
    "contract_fields": {
      "description": "Fields a contract of each kind must fill; a missing one counts as OPEN.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_gap_hours": {
          "description": "Longest wait between two unlocks before analyze reports a pacing gap.",
          "type": "number",
          "minimum": 0
        },
        "run_hours": {
          "description": "Band one player's run to a terminal node should fall in, in the unit of node hours.",
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "kinds": {
              "description": "Terminal kinds the band judges, such as Ending but not Failure; default all.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "named": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "pool": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "description": "Amount at the start of a run.",
          "type": "number",
          "minimum": 0
        },
        "upkeep_per_hour": {
          "description": "Amount the run consumes every hour, such as oxygen or food.",
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "stages",
        "playstyles",
        "terminal_kinds"
      ]
    },
    {
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "enum": [
            "combat",
            "rts"
          ]
        }
      }
    }
  ]
}
