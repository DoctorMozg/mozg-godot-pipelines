{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mozg-godot:design:encounter",
  "title": "encounter",
  "description": "A fight of one hero against waves of units, at design/encounters/<id>.json. A wave starts when the previous one is down, after its delay.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "hero",
    "waves"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "encounter/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Equals the file name without .json."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hero": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Id of a unit in design/units."
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "delay": {
            "type": "number",
            "minimum": 0,
            "description": "Time before the wave arrives; default 0."
          }
        }
      }
    }
  }
}
