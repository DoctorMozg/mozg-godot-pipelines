{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mozg-godot:contract:asset",
  "title": "asset",
  "description": "Identity and slowly changing fields of one registry asset, at registry/assets/<family>/<id>/asset.json. The id never changes.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "family",
    "kind",
    "title",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "asset/1"
    },
    "id": {
      "description": "Slug plus a four-character suffix, such as hero_idle-7f3k.",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*-[0-9a-z]{4}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "image",
        "sprite_frames",
        "model",
        "audio",
        "video",
        "ui",
        "font",
        "shader",
        "text",
        "graph",
        "chart",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string"
    },
    "ship": {
      "description": "True when the asset is meant to ship in the game.",
      "type": "boolean"
    },
    "default_license": {
      "description": "SPDX id or LicenseRef-<name> new versions start from.",
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
