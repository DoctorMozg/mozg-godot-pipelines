{
  "description": "Names the running review hub and retakes waiting for a new version",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/assetkit\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/assetkit\" hook prompt-submit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
