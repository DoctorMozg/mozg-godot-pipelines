{
  "description": "Names the running asset review hub at session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/assetkit\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
