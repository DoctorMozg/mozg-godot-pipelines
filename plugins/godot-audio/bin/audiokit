#!/usr/bin/env bash
# audiokit: cue sheet, audio measures, loops, bus lint and registration for Godot. On the Bash PATH
# while the plugin is enabled.
set -u

here=${0%/*}
[[ $here == "$0" ]] && here=.

if ! command -v python3 >/dev/null 2>&1; then
  echo "audiokit: python3 is not on PATH" >&2
  exit 2
fi

# -B: a run from a checkout or the plugin cache leaves no __pycache__ beside the sources.
exec python3 -I -B "$here/_audiokit_run.py" "$@"
