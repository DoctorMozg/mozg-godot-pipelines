#!/usr/bin/env bash
# godotkit: the godot-core checks (import, parse, boot, tests, gate, lint). On the Bash PATH
# while the plugin is enabled; each command bounds its own Godot runs with --timeout.
set -u

here=${0%/*}
[[ $here == "$0" ]] && here=.

if ! command -v python3 >/dev/null 2>&1; then
  echo "godotkit: python3 is not on PATH" >&2
  exit 2
fi

# -B: a run from a checkout or the plugin cache leaves no __pycache__ beside the sources.
exec python3 -I -B "$here/_godotkit_run.py" "$@"
